<section class="home-intro" aria-labelledby="home-name">
  <figure class="home-photo"><picture><source media="(max-width:700px) and (max-aspect-ratio:3/4)" srcset="/images/home-portrait-mobile-480.webp 480w, /images/home-portrait-mobile-768.webp 768w, /images/home-portrait-mobile-1080.webp 1080w, /images/home-portrait-mobile-1440.webp 1440w" sizes="max(100vw, 460px, 85svh)"><img src="/images/home-portrait-1280.webp" srcset="/images/home-portrait-640.webp 640w, /images/home-portrait-1280.webp 1280w, /images/home-portrait-1920.webp 1920w" sizes="(max-width:700px) and (orientation:portrait) max(100vw, 816px, 151svh), (max-width: 700px) calc(151svh - 193px), (max-width: 1000px) 50vw, 560px" alt="暖色餐厅里的童年照片，坐在餐桌前看向镜头" width="4288" height="2848" fetchpriority="high"></picture></figure>
  <div class="home-copy"><p class="home-eyebrow" translate="no">Chengzhan Li</p><h1 id="home-name"><span class="home-hello">你好，我是</span>LEEcDiang<span class="home-period">.</span></h1><p class="home-description">在电子科技大学学习微电子，<br>也用照片和文字，记录生活。</p><nav class="home-actions" aria-label="首页入口"><a class="home-primary" href="/about/">关于 <span aria-hidden="true">↗</span></a><a href="/archives/">文章列表 <span aria-hidden="true">↗</span></a><a href="/photography/">摄影 <span aria-hidden="true">↗</span></a></nav>{% set latest = site.posts.sort('date', -1).first() %}{% if latest %}<p class="home-latest"><span>最新文章</span><time datetime="{{ moment(latest.date).format() }}">{{ date(latest.date, 'MM.DD') }}</time><a class="home-latest-title" lang="{{ latest.lang }}" href="{{ url_for(latest.path) }}">{{ latest.title }}</a></p>{% endif %}</div>
</section>
