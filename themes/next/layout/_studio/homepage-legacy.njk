{% extends '_layout.njk' %}
{% import '_macro/sidebar.njk' as sidebar_template with context %}

{# ─────────────────────────────────────────────
   首页自定义布局
   不继承 page.njk / index.njk，独立控制 title/H1。
───────────────────────────────────────────── #}

{% block title %}LEEcDiang — Beyond the Clock{% endblock %}

{% block class %}page posts-expand{% endblock %}

{% block content %}
  <div class="post-block" lang="{{ page.lang | default('en') }}">
    <header class="post-header">
      <h1 class="post-title" itemprop="name headline">Beyond the Clock</h1>
      <div class="post-meta-container">
        <div class="post-description" style="margin-top: 0.5em; text-align: center; color: var(--text-color-secondary, #999); font-size: 0.9em;">
          A personal archive by LEEcDiang.
        </div>
      </div>
    </header>
    <div class="post-body">
      {{ page.content }}
    </div>
  </div>
{% endblock %}

{% block sidebar %}
  {{ sidebar_template.render(page.toc.enable) }}
{% endblock %}
