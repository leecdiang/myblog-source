<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <script>(function(){var p='system';try{p=localStorage.getItem('leecdiang-color')||'system'}catch(e){}if(!['light','dark','system'].includes(p))p='system';document.documentElement.dataset.color=p==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):p;})();</script>
  <script>(function(){var l;try{l=localStorage.getItem('leecdiang-language')}catch(e){}if(l!=='zh'&&l!=='en')l=/^zh\b/i.test(navigator.language||'zh')?'zh':'en';document.documentElement.dataset.language=l;document.documentElement.lang=l==='zh'?'zh-CN':'en';})();</script>
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="stylesheet" data-studio-style href="{{ studio_asset('style') }}">
  {% set rich_content = is_post() or page.mathjax or (page.content and ('<table' in page.content or '<pre' in page.content or 'class="tabs' in page.content)) %}
  {% if rich_content %}
  {{ next_data('main', next_config()) }}
  <script defer src="{{ studio_asset('content') }}"></script>
  {% endif %}
  {%- include '_partials/head/head-unique.njk' -%}
  <title>{% block title %}{% endblock %}</title>
  {{ partial('_third-party/analytics/index.njk', {}, {cache: theme.cache.enable}) }}
  {% if rich_content and studio_has_math(page) %}{{ next_data('enableMath', true) }}{%- include '_third-party/math/mathjax.njk' -%}{% endif %}
  {% if page.content and 'mermaid' in page.content %}{%- include '_third-party/tags/mermaid-studio.njk' -%}{% endif %}
  {% if page.content and 'v-chart-viewport' in page.content %}<script defer src="/js/visual-diagrams.js"></script>{% endif %}
  <script defer src="{{ studio_asset('core') }}"></script>
  {% if page.path === 'links/index.html' %}<script defer src="{{ studio_asset('orrery') }}"></script>{% endif %}
  {% if page.layout === 'homepage' %}<link rel="preload" as="image" href="/images/home-portrait-1280.webp" imagesrcset="/images/home-portrait-640.webp 640w, /images/home-portrait-1280.webp 1280w, /images/home-portrait-1920.webp 1920w" imagesizes="(max-width: 700px) calc(151svh - 193px), (max-width: 1000px) 50vw, 560px">{% endif %}
</head>
<body class="studio-site studio-halo{% if is_post() %} studio-reading{% endif %}{% if page.layout === 'homepage' %} studio-home{% endif %}">
  <div class="ambient-halo" aria-hidden="true">
    <picture class="ambient-art ambient-art--light"><source media="(orientation: portrait)" data-srcset="/images/ambient/halo-light-portrait-v6.webp"><img data-ambient-src="/images/ambient/halo-light-landscape-v8.webp" width="1672" height="941" alt="" decoding="async" fetchpriority="low"></picture>
    <picture class="ambient-art ambient-art--dark"><source media="(orientation: portrait)" data-srcset="/images/ambient/halo-dark-portrait-v2.webp"><img data-ambient-src="/images/ambient/halo-dark-landscape-v2.webp" width="1672" height="941" alt="" decoding="async" fetchpriority="low"></picture>
  </div>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <header class="studio-header">
    <a class="studio-brand" href="/" translate="no" aria-label="LEEcDiang 首页">LEEcDiang<span>.</span></a>
    {% if page.layout !== 'homepage' %}<nav aria-label="主导航">
      <a href="/photography/"{% if page.layout === 'photography' %} aria-current="page"{% endif %}>摄影</a>
      <a href="/archives/"{% if is_archive() or is_post() or is_category() or is_tag() or page.path === 'categories/index.html' or page.path === 'tags/index.html' %} aria-current="page"{% endif %}>文章</a>
      <a href="/about/"{% if page.path === 'about/index.html' %} aria-current="page"{% endif %}>关于</a>
    </nav>{% endif %}
    <div class="header-controls"><button type="button" id="language-mode" class="language-toggle" aria-label="Switch to English" title="Switch to English">EN</button>
    <button type="button" id="color-mode" class="theme-toggle" aria-label="切换深浅色主题" title="切换深浅色主题">
      <svg class="theme-icon-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13.1A8.6 8.6 0 0 1 10.9 3.5 8.6 8.6 0 1 0 20.5 13.1Z"/></svg>
      <svg class="theme-icon-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
    </button></div>
  </header>
  <main id="main-content" tabindex="-1" class="studio-main main-inner{% if page.layout !== 'homepage' and page.path !== 'about/index.html' %} studio-content-plane{% endif %} {% block class %}{% endblock %}">
    {% block content %}{% endblock %}
    {%- include '_partials/comments.njk' -%}
  </main>
  <footer class="studio-footer"><span>© {{ moment().format('YYYY') }} LEEcDiang</span><div><a href="/links/">Links</a><a href="mailto:simonlee820@gmail.com">Email ↗</a><a href="https://github.com/leecdiang" target="_blank" rel="noopener">GitHub ↗</a></div></footer>
</body></html>
