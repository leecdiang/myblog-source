<script>
(function() {
  var desc = document.querySelector('.site-description');
  if (desc && !desc.querySelector('.desc-line2')) {
    var l2 = document.createElement('div');
    l2.className = 'desc-line2';
    l2.textContent = 'Digital IC · Architecture';
    desc.appendChild(l2);

    var l3 = document.createElement('div');
    l3.className = 'desc-line3';
    l3.textContent = 'Tools · Photography';
    desc.appendChild(l3);

    var l4 = document.createElement('div');
    l4.className = 'desc-line4';
    l4.textContent = 'Personal archive across silicon, systems, and visual notes.';
    desc.appendChild(l4);
  }
})();
</script>

<script>
(function () {
  var LONG_POST_HEIGHT = 24000;
  var LONG_POST_AREA = 18000000;
  var DESKTOP_QUERY = '(min-width: 992px)';

  function isSafariBrowser() {
    var ua = navigator.userAgent;
    return /Safari/.test(ua) &&
      !/Chrome|Chromium|CriOS|Edg|OPR|Firefox|FxiOS/.test(ua);
  }

  function findVisiblePostBlock() {
    var candidates = Array.prototype.slice.call(
      document.querySelectorAll('.post-block')
    );

    candidates = candidates.filter(function (element) {
      var rect = element.getBoundingClientRect();
      var style = getComputedStyle(element);
      return (
        style.display !== 'none' &&
        style.visibility !== 'hidden' &&
        rect.width > 100 &&
        element.querySelector('.post-content')
      );
    });

    candidates.sort(function (a, b) {
      return b.scrollHeight - a.scrollHeight;
    });

    return candidates[0] || null;
  }

  function recordSafariGlassInit(ok, reason, details) {
    window.__safariLongPostGlassLastInit = {
      ok: ok,
      reason: reason,
      details: details || null,
      time: Date.now(),
      readyState: document.readyState
    };
    console.info('[Safari long-post glass init]', window.__safariLongPostGlassLastInit);
    return ok;
  }

  var safariLongPostBootTimer = null;
  var safariLongPostBootAttempt = 0;
  var SAFARI_LONG_POST_MAX_ATTEMPTS = 12;
  var SAFARI_LONG_POST_RETRY_DELAY = 250;

  function cleanupSafariLongPostGlass() {
    if (safariLongPostBootTimer !== null) {
      clearTimeout(safariLongPostBootTimer);
      safariLongPostBootTimer = null;
    }
    safariLongPostBootAttempt = 0;

    var state = window.__safariLongPostGlassState;

    if (!state) {
      document
        .querySelectorAll('.post-portal-sampler')
        .forEach(function (node) { node.remove(); });

      document.documentElement.classList.remove('is-safari-long-post');
      delete window.__safariLongPostGlassLastInit;
      delete window.__safariLongPostGlassBootTrace;
      return;
    }

    window.removeEventListener('scroll', state.scheduleUpdate);
    window.removeEventListener('resize', state.scheduleUpdate);

    if (window.visualViewport) {
      window.visualViewport.removeEventListener('resize', state.scheduleUpdate);
      window.visualViewport.removeEventListener('scroll', state.scheduleUpdate);
    }

    if (state.resizeObserver) {
      state.resizeObserver.disconnect();
    }

    if (state.sampler) {
      state.sampler.remove();
    }

    document.documentElement.classList.remove('is-safari-long-post');
    delete window.__safariLongPostGlassState;
    delete window.__safariLongPostGlassLastInit;
    delete window.__safariLongPostGlassBootTrace;
  }

  function initSafariLongPostGlass() {
    // 已经成功初始化：只更新几何
    if (
      window.__safariLongPostGlassState &&
      document.querySelector('body > .post-portal-sampler')
    ) {
      window.__safariLongPostGlassState.scheduleUpdate();
      return recordSafariGlassInit(true, 'already-initialized');
    }

    if (!isSafariBrowser()) {
      return recordSafariGlassInit(false, 'not-safari');
    }

    if (!window.matchMedia(DESKTOP_QUERY).matches) {
      return recordSafariGlassInit(false, 'not-desktop', { innerWidth: window.innerWidth });
    }

    var postBlock = findVisiblePostBlock();
    if (!postBlock) {
      return recordSafariGlassInit(false, 'post-block-not-ready', {
        totalPostBlocks: document.querySelectorAll('.post-block').length
      });
    }

    var rect = postBlock.getBoundingClientRect();
    var height = postBlock.scrollHeight;
    var width = rect.width;
    var area = height * width;

    if (width <= 100 || height <= 0) {
      return recordSafariGlassInit(false, 'invalid-geometry', {
        width: width,
        height: height,
        area: area,
        display: getComputedStyle(postBlock).display,
        visibility: getComputedStyle(postBlock).visibility
      });
    }

    if (height < LONG_POST_HEIGHT && area < LONG_POST_AREA) {
      return recordSafariGlassInit(false, 'below-threshold', {
        width: width,
        height: height,
        area: area
      });
    }

    var postContent = postBlock.querySelector('.post-content');
    if (!postContent) {
      return recordSafariGlassInit(false, 'post-content-not-ready');
    }

    document.documentElement.classList.add('is-safari-long-post');

    var sampler = document.createElement('div');
    sampler.className = 'post-portal-sampler';
    sampler.setAttribute('aria-hidden', 'true');
    document.body.appendChild(sampler);

    var pseudoStyle = getComputedStyle(postBlock, '::before');
    var radii = {
      topLeft: pseudoStyle.borderTopLeftRadius,
      topRight: pseudoStyle.borderTopRightRadius,
      bottomRight: pseudoStyle.borderBottomRightRadius,
      bottomLeft: pseudoStyle.borderBottomLeftRadius
    };

    var scheduled = false;

    function updateSampler() {
      scheduled = false;

      if (!window.matchMedia(DESKTOP_QUERY).matches) {
        sampler.style.visibility = 'hidden';
        return;
      }

      var rect = postBlock.getBoundingClientRect();
      var viewportTop = 0;
      var viewportBottom = window.innerHeight;

      var visibleTop = Math.max(rect.top, viewportTop);
      var visibleBottom = Math.min(rect.bottom, viewportBottom);
      var visibleHeight = Math.max(0, visibleBottom - visibleTop);

      if (visibleHeight <= 0 || rect.width <= 0) {
        sampler.style.visibility = 'hidden';
        return;
      }

      sampler.style.visibility = 'visible';
      sampler.style.left = rect.left + 'px';
      sampler.style.top = visibleTop + 'px';
      sampler.style.width = rect.width + 'px';
      sampler.style.height = visibleHeight + 'px';

      var articleTopVisible = rect.top >= viewportTop;
      var articleBottomVisible = rect.bottom <= viewportBottom;

      sampler.style.borderTopLeftRadius = articleTopVisible ? radii.topLeft : '0px';
      sampler.style.borderTopRightRadius = articleTopVisible ? radii.topRight : '0px';
      sampler.style.borderBottomRightRadius = articleBottomVisible ? radii.bottomRight : '0px';
      sampler.style.borderBottomLeftRadius = articleBottomVisible ? radii.bottomLeft : '0px';
    }

    function scheduleUpdate() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateSampler);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', scheduleUpdate);
      window.visualViewport.addEventListener('scroll', scheduleUpdate);
    }

    var resizeObserver = null;
    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(scheduleUpdate);
      resizeObserver.observe(postBlock);
    }

    window.__safariLongPostGlassState = {
      sampler: sampler,
      postBlock: postBlock,
      scheduleUpdate: scheduleUpdate,
      resizeObserver: resizeObserver
    };

    updateSampler();

    return recordSafariGlassInit(true, 'initialized', {
      width: width,
      height: height,
      area: area
    });
  }

  function cancelSafariLongPostBoot() {
    if (safariLongPostBootTimer !== null) {
      clearTimeout(safariLongPostBootTimer);
      safariLongPostBootTimer = null;
    }
  }

  function bootSafariLongPostGlass() {
    cancelSafariLongPostBoot();
    safariLongPostBootAttempt += 1;

    requestAnimationFrame(function () {
      var initialized = initSafariLongPostGlass();

      window.__safariLongPostGlassBootTrace = {
        attempt: safariLongPostBootAttempt,
        initialized: initialized,
        lastInit: window.__safariLongPostGlassLastInit,
        time: Date.now()
      };

      if (initialized) {
        console.info('[Safari long-post glass boot success]', window.__safariLongPostGlassBootTrace);
        return;
      }

      if (safariLongPostBootAttempt >= SAFARI_LONG_POST_MAX_ATTEMPTS) {
        console.warn('[Safari long-post glass boot exhausted]', window.__safariLongPostGlassBootTrace);
        return;
      }

      safariLongPostBootTimer = setTimeout(bootSafariLongPostGlass, SAFARI_LONG_POST_RETRY_DELAY);
    });
  }

  function restartSafariLongPostGlassBoot() {
    cancelSafariLongPostBoot();
    safariLongPostBootAttempt = 0;
    bootSafariLongPostGlass();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restartSafariLongPostGlassBoot, { once: true });
  } else {
    restartSafariLongPostGlassBoot();
  }

  window.addEventListener('load', restartSafariLongPostGlassBoot, { once: true });

  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      restartSafariLongPostGlassBoot();
    }
  });

  document.addEventListener('pjax:success', function () {
    cleanupSafariLongPostGlass();
    restartSafariLongPostGlassBoot();
  });

  window.__initSafariLongPostGlass = initSafariLongPostGlass;
  window.__cleanupSafariLongPostGlass = cleanupSafariLongPostGlass;
  window.__restartSafariLongPostGlassBoot = restartSafariLongPostGlassBoot;
})();
</script>
