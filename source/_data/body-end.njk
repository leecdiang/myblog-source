<script>
(function () {
  var metas = Array.prototype.slice.call(document.querySelectorAll('meta[name="theme-color"]'));
  if (!metas.length) { var made = document.createElement('meta'); made.name = 'theme-color'; document.head.appendChild(made); metas = [made]; }
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  function apply() {
    for (var i = 0; i < metas.length; i++) {
      var m = metas[i];
      var media = m.getAttribute('media') || '';
      var dark = media.indexOf('dark') >= 0;
      var light = media.indexOf('light') >= 0;
      m.setAttribute('content', dark ? '#121f2b' : (light ? '#eaf5fb' : (mq.matches ? '#121f2b' : '#eaf5fb')));
    }
  }
  apply();
  if (mq.addEventListener) mq.addEventListener('change', apply);
  else if (mq.addListener) mq.addListener(apply);
})();
</script>

